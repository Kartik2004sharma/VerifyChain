{
  "name": "verifychain",
  "version": "1.0.0",
  "private": true,
  "description": "Blockchain-based product authentication and counterfeit detection system",
  "author": "Kartik Sharma",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib tests scripts middleware.ts next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "abi:export": "node scripts/export-abis.cjs",
    "test:e2e": "playwright test",
    "release:check": "node scripts/release-check.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run contracts:test && npm run test:integration && npm run build",
    "format": "prettier --write app components lib tests scripts *.ts *.mjs *.cjs test/*.js",
    "test:integration": "node scripts/local-integration.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.21",
    "@wagmi/core": "2.22.1",
    "wagmi": "2.19.5",
    "viem": "2.57.2",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next-themes": "0.4.6",
    "lucide-react": "0.511.0",
    "qrcode": "1.5.4",
    "html5-qrcode": "2.3.8",
    "jspdf": "4.2.1",
    "zod": "4.3.6",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "6.1.0",
    "@openzeppelin/contracts": "5.4.0",
    "dotenv": "17.3.1",
    "hardhat": "2.29.1",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/qrcode": "1.5.6",
    "typescript": "5.9.3",
    "eslint": "9.39.3",
    "eslint-config-next": "15.5.27",
    "@eslint/eslintrc": "3.3.4",
    "@playwright/test": "1.58.2",
    "@axe-core/playwright": "4.11.1",
    "vitest": "4.1.11",
    "@lhci/cli": "0.15.1",
    "@testing-library/react": "16.3.2",
    "jsdom": "28.1.0",
    "prettier": "3.8.1",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "@types/pngjs": "6.0.5",
    "playwright-core": "1.58.2"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "overrides": {
    "lodash": "4.18.1",
    "picomatch@^2": "2.3.2",
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "ws": "8.22.0",
    "playwright": "1.58.2",
    "playwright-core": "1.58.2",
    "handlebars": "4.7.9"
  }
}
